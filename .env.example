# Ad Forge — deploy-time configuration.
# Copy to .env (or set these in your host's env) and fill in real values.
# NEVER commit real keys to git. Every value is optional — the app runs
# at $0 in stub mode with none of them set.

# --- Stripe Payment Links (public URLs, not secrets) ---
# Dashboard -> Payment Links -> create one recurring link per tier and
# paste its URL. Until a tier's link is set, its pricing button falls
# back to an email notify-me capture.
#   Starter  $19/mo:
AD_FORGE_PAYMENT_LINK_STARTER=https://buy.stripe.com/REPLACE_ME
#   Pro      $49/mo:
AD_FORGE_PAYMENT_LINK_PRO=https://buy.stripe.com/REPLACE_ME
#   Agency   $99/mo:
AD_FORGE_PAYMENT_LINK_AGENCY=https://buy.stripe.com/REPLACE_ME

# --- Video generation provider (optional) ---
# Any HTTP API that accepts a JSON POST {"package": {...}} with a Bearer
# key and returns {"job_id": "..."} or {"video_url": "..."}.
# Leave both blank for storyboard (stub) mode.
VIDEO_API_URL=
VIDEO_API_KEY=

# --- App ---
BASE_URL=https://adforge.onrender.com     # public URL of the deployment
DB_PATH=/data/adforge.db                  # persistent disk path on Render
CONTACT_EMAIL=justinwaynedillon5@gmail.com
FREE_PACKAGE_LIMIT=3                      # free ad packages per email
